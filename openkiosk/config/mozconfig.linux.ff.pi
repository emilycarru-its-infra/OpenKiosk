# FIREFOX RASP PI

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../opt-ff-@CONFIG_GUESS@

mk_add_options MOZ_MAKE_FLAGS="-j6"

# START CUSTOM
ac_add_options --enable-application=browser
ac_add_options --with-app-name=Firefox
ac_add_options --enable-update-channel=esr
ac_add_options --enable-official-branding
ac_add_options --disable-debug-symbols
ac_add_options --disable-tests
ac_add_options --disable-install-strip
ac_add_options --enable-release
ac_add_options --enable-default-toolkit=cairo-gtk3

ac_add_options --host=x86_64-pc-linux-gnu
ac_add_options --target=armv7-unknown-linux-gnueabihf

export PKG_CONFIG="arm-linux-gnueabihf-pkg-config"

export MOZILLA_OFFICIAL=1

# GCC 8.4
export CC="arm-linux-gnueabihf-gcc"
export CXX="arm-linux-gnueabihf-g++"
export AR="arm-linux-gnueabihf-gcc-ar"

export HOST_CC="x86_64-linux-gnu-gcc-8"
export HOST_CXX="x86_64-linux-gnu-g++-8"
export HOST_AR="x86_64-linux-gnu-ar"

export RUSTC=$(rustup which rustc)
export CARGO=$(rustup which cargo)

