# Linux 64 Bit Build

# ok custom variables
. $topsrcdir/openkiosk/config/common

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/../opt-openkiosk-@CONFIG_GUESS@

mk_add_options MOZ_MAKE_FLAGS="-s -j8"

ac_add_options --enable-application=openkiosk

ac_add_options --enable-update-channel=release
ac_add_options --enable-official-branding
ac_add_options --enable-js-shell

# Disable crash reporter
ac_add_options --disable-crashreporter

# SPEEDS UP BUILD TIME
ac_add_options --disable-tests

# ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --enable-bootstrap

ac_add_options --host=x86_64-pc-linux-gnu
ac_add_options --target=x86_64-linux-gnu

export MOZILLA_OFFICIAL=1
export BUILDING_RELEASE=1
export MOZ_PACKAGE_JSSHELL=1

mk_add_options AUTOCLOBBER=1

# Disable Telemetry
ac_add_options MOZ_TELEMETRY_REPORTING=
ac_add_options MOZ_TELEMETRY_ON_BY_DEFAULT=
ac_add_options MOZ_UPDATER=

