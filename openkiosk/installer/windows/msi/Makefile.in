STANDALONE_MAKEFILE := 1
DIST_SUBDIR := browser

include $(topsrcdir)/config/rules.mk

ifeq ($(TARGET_CPU),x86_64)
  PROGRAM_FOLDER=ProgramFiles64Folder
  HEADER=openkiosk64.mmh
  UUID=`cat $(topsrcdir)/$(MOZ_BRANDING_DIRECTORY)/uuid64.txt`
else
  PROGRAM_FOLDER=ProgramFilesFolder
  HEADER=openkiosk.mmh
  UUID=`cat $(topsrcdir)/$(MOZ_BRANDING_DIRECTORY)/uuid.txt`
endif

DATE_STAMP=`date +"%Y-%m-%d"`
UUID=`cat $(topsrcdir)/$(MOZ_BRANDING_DIRECTORY)/uuid.txt`

DEFINES += \
        -DAB_CD=$(AB_CD) \
        -DMOZ_APP_VERSION=$(MOZ_APP_VERSION) \
        -DMOZ_APP_DISPLAYNAME='${MOZ_APP_DISPLAYNAME}' \
        -DMOZILLA_VERSION=${MOZILLA_VERSION} \
        -DMOZ_BRANDING_DIRECTORY=${MOZ_BRANDING_DIRECTORY} \
        -DDATE=$(DATE_STAMP) \
        -DMOZ_APP_NAME=$(MOZ_APP_NAME) \
        -DMSI_UUID=$(UUID) \
        $(NULL)

msi-installer:
	mkdir -p $(DIST)/msi/
	cp $(topsrcdir)/$(MOZ_BRANDING_DIRECTORY)/license.rtf $(DIST)/msi/
	cp $(topsrcdir)/$(MOZ_BRANDING_DIRECTORY)/msi.bmp $(DIST)/msi/
	cp $(srcdir)/$(HEADER) $(DIST)/msi/
	cp $(topsrcdir)/$(MOZ_BRANDING_DIRECTORY)/openkiosk.ico $(DIST)/msi/
	$(PERL) $(srcdir)/preprocessor.pl -Fsubstitution $(DEFINES) $(ACDEFINES)  \
	$(DEPTH)/../mozilla/openkiosk/installer/windows/msi/openkiosk.ver.in > $(DIST)/msi/openkiosk.ver;
	sed -e 's:__MOZ_APP_NAME__:$(MOZ_APP_NAME):g' -e 's:__MOZ_APP_DISPLAYNAME__:$(MOZ_APP_DISPLAYNAME):g' -e's:__PROGRAM_FOLDER__:$(PROGRAM_FOLDER):g' -e's:__HEADER__:$(HEADER):g' $(srcdir)/openkiosk.mm.in > $(DIST)/msi/openkiosk.mm
	rm -rf $(DIST)/msi-stage
	mkdir -p  $(DIST)/msi-stage
	cp -r $(DIST)/openkiosk/* $(DIST)/msi-stage/
	cd $(DIST)/msi/;     \
	PATH=$$PATH:/c/Program\ Files\ \(x86\)/MakeMsi/; /c/Windows/System32/cmd.exe //c ""MM.CMD"";   \
	cp out/openkiosk.mm/MSI/$(MOZ_APP_DISPLAYNAME)-MSI.msi ../$(MOZ_APP_DISPLAYNAME)-$(MOZ_APP_VERSION)-$(DATE_STAMP).msi

uuid:
	@echo $(UUID);

version:
	@echo $(MOZ_APP_VERSION);

name:
	@echo $(MOZ_APP_DISPLAYNAME);


